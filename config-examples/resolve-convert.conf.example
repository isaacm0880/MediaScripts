# Optional configuration for resolve-convert
# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/media-tools/resolve-convert.conf
# Bash assignments. CLI > environment > config > built-in defaults.
# PREFER_LANG=eng                 # prefer English first; keep other audio tracks
SUBS=sidecar                     # sidecar | keep | drop
PCM_BITS=auto                    # auto | 16 | 24 | 32
CONTAINER=auto
VIDEO_TARGET=auto                # auto | dnxhr_lb | dnxhr_sq | dnxhr_hq | dnxhr_hqx | dnxhr_444
AUDIO_COPY_CODECS="pcm_s16le pcm_s24le pcm_s32le"
VIDEO_COPY_CODECS="prores dnxhd"
VIDEO_UNKNOWN_CODECS="cfhd mjpeg mpeg4 mpeg2video"
# MOV_AUDIO_OK="aac ac3 eac3 mp3 alac pcm_s16le pcm_s24le pcm_s32le pcm_s16be pcm_s24be pcm_s32be pcm_f32le pcm_f32be"
# MOV_VIDEO_OK="h264 hevc prores dnxhd cfhd mjpeg mpeg4 mpeg2video"
# REMUX_EXTS="webm flv ogv ogg wmv asf ivf"
# OUT_SUFFIX=" - Resolve"
# OUT_DIR="$HOME/Videos/converted"
# CFR_RATE=30                     # optional; leave unset to preserve frame rate
