#!/usr/bin/env bash
set -Eeuo pipefail

# Extract embedded cover art from an audio file and centre-crop it square.
# Dolphin launches without a terminal, so report errors and results using KDE dialogs.
report() {
    local level=$1 message=$2
    if command -v kdialog >/dev/null 2>&1 && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        if [[ $level == error ]]; then kdialog --error "$message"; else kdialog --msgbox "$message"; fi
    else
        printf '%s\n' "$message" >&2
    fi
}
trap 'rc=$?; if ((rc != 0)); then report error "Square cover extraction failed (exit code $rc). Run the command in a terminal for details."; fi' EXIT

# Usage: audio-extract-square-cover.sh FILE [OUTPUT.jpg]

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 AUDIO_FILE [OUTPUT.jpg]" >&2
    exit 2
fi

input=$(realpath -- "$1")
[[ -f "$input" ]] || { echo "File not found: $input" >&2; exit 1; }

for cmd in ffmpeg ffprobe; do
    command -v "$cmd" >/dev/null || {
        echo "Missing dependency: $cmd (install with: sudo pacman -S ffmpeg)" >&2
        exit 1
    }
done

if [[ $# -eq 2 ]]; then
    output=$2
else
    output="$(dirname -- "$input")/$(basename -- "${input%.*}")-thumbnail.jpg"
fi

# Locate the embedded cover-art stream.
stream=$(
    ffprobe -v error -select_streams v \
        -show_entries stream=index:stream_disposition=attached_pic \
        -of json "$input" |
    python -c '
import json, sys
data = json.load(sys.stdin)
for s in data.get("streams", []):
    if s.get("disposition", {}).get("attached_pic", 0):
        print(s["index"])
        break
'
)

if [[ -z "$stream" ]]; then
    echo "No embedded cover artwork found in: $input" >&2
    exit 1
fi

mkdir -p -- "$(dirname -- "$output")"
[[ ! -e "$output" ]] || { echo "Output already exists: $output" >&2; exit 1; }
tmp=$(mktemp --tmpdir="$(dirname -- "$output")" --suffix=.jpg)
trap 'rc=$?; rm -f -- "$tmp"; if ((rc != 0)); then report error "Square cover extraction failed (exit code $rc). Run the command in a terminal for details."; fi' EXIT

ffmpeg -hide_banner -loglevel error -y \
    -i "$input" -map "0:$stream" -frames:v 1 \
    -vf "crop=min(iw\,ih):min(iw\,ih):(iw-min(iw\,ih))/2:(ih-min(iw\,ih))/2" \
    -q:v 2 "$tmp"

mv -n -- "$tmp" "$output"
trap - EXIT

report info "Saved square cover: $output"
