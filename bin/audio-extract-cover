#!/usr/bin/env bash
# Extract embedded cover artwork from selected audio files as PNGs.
set -u

if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error 'FFmpeg is not installed. Install it with: sudo pacman -S ffmpeg'
    else
        printf '%s\n' 'FFmpeg is not installed. Install it with: sudo pacman -S ffmpeg' >&2
    fi
    exit 1
fi

success=0
skipped=0
failed=()

for input in "$@"; do
    [[ -f "$input" ]] || continue
    dir=$(dirname -- "$input")
    filename=$(basename -- "$input")
    stem="${filename%.*}"
    output="$dir/$stem.png"

    if [[ -e "$output" ]]; then
        if command -v kdialog >/dev/null 2>&1; then
            kdialog --yesno "The output already exists:\n$output\n\nOverwrite it?" || { skipped=$((skipped + 1)); continue; }
        else
            printf 'Skipping existing file: %s\n' "$output" >&2
            skipped=$((skipped + 1))
            continue
        fi
    fi

    # Extract to a temporary file first; never destroy existing output on failure.
    tmp=$(mktemp -- "$dir/.artwork-XXXXXXXX.png") || { failed+=("$filename"); continue; }
    stream=$(ffprobe -v error -select_streams v -show_entries stream=index:stream_disposition=attached_pic -of json "$input" | python3 -c 'import json,sys; print(next((str(s["index"]) for s in json.load(sys.stdin).get("streams",[]) if s.get("disposition",{}).get("attached_pic")), ""))')
    if [[ -z "$stream" ]]; then rm -f -- "$tmp"; failed+=("$filename"); continue; fi
    if ffmpeg -nostdin -hide_banner -loglevel error -y -i "$input" \
        -map "0:$stream" -frames:v 1 -c:v png "$tmp" && mv -f -- "$tmp" "$output"; then
        success=$((success + 1))
    else
        rm -f -- "$tmp"
        failed+=("$filename")
    fi
done

message="Extracted artwork from $success file(s)."
(( skipped > 0 )) && message+=$'\nSkipped: '"$skipped"
if ((${#failed[@]})); then
    message+=$'\n\nCould not extract artwork (no embedded picture or unsupported file):\n'
    message+=$(printf '%s\n' "${failed[@]}")
fi

if command -v kdialog >/dev/null 2>&1; then
    if (( success == 0 )) && ((${#failed[@]})); then
        kdialog --error "$message"
    else
        kdialog --msgbox "$message"
    fi
else
    printf '%s\n' "$message"
fi
