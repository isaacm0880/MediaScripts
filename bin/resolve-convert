#!/usr/bin/env bash
# resolve-convert - make media importable by DaVinci Resolve Studio on Linux.
#
# YOU choose what gets converted (audio only / video only / both / analyse only),
# either from the interactive menu or with --audio-only / --video-only / --both /
# --analyze.  Codec detection only INFORMS: it produces an assessment, warnings and
# a recommendation, but never changes the mode you picked.
#
#   * a stream that is not selected for conversion is always stream-copied
#   * audio -> uncompressed PCM, video -> DNxHR (only for the selected streams)
#   * a plan summary is shown and must be confirmed before anything is encoded
#   * originals are never modified; output is written to a temp file and moved
#     into place only when ffmpeg succeeded; existing files are never overwritten
#
set -u -o pipefail

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
ROOT=$(dirname "$(dirname "$SELF")")
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh" || { echo "cannot load $ROOT/lib/common.sh" >&2; exit 2; }

usage() {
  cat <<'EOF'
Usage: resolve-convert [mode] [options] [--] FILE...

Mode (if none is given, an interactive menu asks - nothing is ever chosen for you):
      --audio-only    convert audio to PCM, COPY the video untouched
      --video-only    convert video to DNxHR, COPY the audio untouched
      --both          convert audio and video
      --analyze       inspect and recommend; encodes/writes nothing

Options (default in brackets):
  -y, --yes           skip the final "Proceed?" question (only when a mode was
                      given on the command line; the menu is never skipped)
  -n, --dry-run       show the plan and the exact ffmpeg command; write nothing
      --pcm-bits auto|16|24|32      [auto]  auto = 24-bit for lossless/high-bit
                                              sources, otherwise 16-bit
      --video-target auto|dnxhr_lb|dnxhr_sq|dnxhr_hq|dnxhr_hqx|dnxhr_444   [auto]
      --cfr RATE      constant frame rate for converted video (e.g. 30000/1001, 25);
                      needs --video-only or --both. Default: frame rate never touched.
      --prefer-lang LIST   put these audio languages first, e.g. eng or eng,jpn.
                      All tracks are kept. [source order]
      --subs sidecar|keep|drop      [sidecar] sidecar = text subtitles written to .srt
                      next to the output, bitmap subtitles reported and omitted;
                      keep = copy into an MKV; drop = omit (reported).
      --container auto|mov|mkv      [auto]  auto = MOV (MKV with --subs keep, or when
                      MOV cannot hold a copied stream - you are asked / told)
  -o, --out-dir DIR   write results into DIR (default: beside the input)
      --suffix TEXT   name suffix [" - Resolve"]
      --pick          choose files with a KDE file dialog (kdialog)
      --pause         wait for Enter before the terminal closes
  -h, --help          --version

With several files, each file is shown, asked about and confirmed separately; after
choosing a mode in the menu you may apply it to all remaining files.

Exit status: 0 all fine, 1 at least one failure, 2 usage error / missing dependency
/ cannot ask a question without a terminal.

Config file (optional, plain shell assignments, see config/resolve-convert.conf.example):
  ${XDG_CONFIG_HOME:-~/.config}/media-tools/resolve-convert.conf
EOF
}

# ----------------------------------------------------------- configuration ---
CFG_VARS=(FFMPEG FFPROBE PCM_BITS PREFER_LANG SUBS CONTAINER VIDEO_TARGET
  AUDIO_COPY_CODECS VIDEO_COPY_CODECS VIDEO_UNKNOWN_CODECS MOV_VIDEO_OK MOV_AUDIO_OK
  REMUX_EXTS SUB_TEXT_CODECS SUB_BITMAP_CODECS OUT_SUFFIX OUT_DIR CFR_RATE)
mt_load_config resolve-convert "${CFG_VARS[@]}"

: "${FFMPEG:=ffmpeg}"
: "${FFPROBE:=ffprobe}"
: "${PCM_BITS:=auto}"
: "${PREFER_LANG:=}"
: "${SUBS:=sidecar}"
: "${CONTAINER:=auto}"
: "${VIDEO_TARGET:=auto}"
# ---- audio policy: ONLY these codecs are copied; everything else -> PCM.
#      (FLAC is intentionally absent: Linux support is unconfirmed, and FLAC->PCM
#       is lossless anyway.  Add it here if you have verified it on your build.)
: "${AUDIO_COPY_CODECS:=pcm_s16le pcm_s24le pcm_s32le}"
# ---- video ASSESSMENT policy (informs you; never forces anything).  h264/hevc get
#      profile-aware rules in assess_video().
: "${VIDEO_COPY_CODECS:=prores dnxhd}"                 # known-good intra codecs
: "${VIDEO_UNKNOWN_CODECS:=cfhd mjpeg mpeg4 mpeg2video}" # support unconfirmed
: "${MOV_VIDEO_OK:=h264 hevc prores dnxhd cfhd mjpeg mpeg4 mpeg2video}"
: "${MOV_AUDIO_OK:=aac ac3 eac3 mp3 alac pcm_s16le pcm_s24le pcm_s32le pcm_s16be pcm_s24be pcm_s32be pcm_f32le pcm_f32be}"
: "${REMUX_EXTS:=webm flv ogv ogg wmv asf ivf}"         # containers Resolve won't open
: "${SUB_TEXT_CODECS:=subrip srt ass ssa webvtt mov_text text microdvd subviewer subviewer1 sami jacosub realtext stl vplayer}"
: "${SUB_BITMAP_CODECS:=hdmv_pgs_subtitle dvd_subtitle dvb_subtitle xsub}"
: "${OUT_SUFFIX:= - Resolve}"
: "${OUT_DIR:=}"
: "${CFR_RATE:=}"

DRY=0; PICK=0; YES=0
MODE=""; MODE_ALL=""; MODE_FROM_CLI=0
FILES=()

while (($#)); do
  case $1 in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
  case $1 in
    --audio-only)    MODE=audio;   MODE_FROM_CLI=1; shift ;;
    --video-only)    MODE=video;   MODE_FROM_CLI=1; shift ;;
    --both)          MODE=both;    MODE_FROM_CLI=1; shift ;;
    --analyze|--analyse) MODE=analyze; MODE_FROM_CLI=1; shift ;;
    -y|--yes)        YES=1; shift ;;
    --pcm-bits)      [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; PCM_BITS=$2; shift 2 ;;
    --video-target)  [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; VIDEO_TARGET=$2; shift 2 ;;
    --cfr)           [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; CFR_RATE=$2; shift 2 ;;
    --prefer-lang)   [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; PREFER_LANG=$2; shift 2 ;;
    --subs)          [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; SUBS=$2; shift 2 ;;
    --container)     [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; CONTAINER=$2; shift 2 ;;
    -o|--out-dir)    [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; OUT_DIR=$2; shift 2 ;;
    --suffix)        [[ $# -ge 2 ]] || mt_die 2 "$1 needs a value"; OUT_SUFFIX=$2; shift 2 ;;
    -n|--dry-run)    DRY=1; shift ;;
    --pick)          PICK=1; shift ;;
    --pause)         MT_PAUSE=1; shift ;;
    -h|--help)       usage; exit 0 ;;
    --version)       echo "resolve-convert $MT_VERSION"; exit 0 ;;
    --)              shift; FILES+=("$@"); break ;;
    -*)              mt_err "Unknown option: $1"; usage >&2; exit 2 ;;
    *)               FILES+=("$1"); shift ;;
  esac
done

mt_install_traps

# ---- validate option values -------------------------------------------------
case $PCM_BITS in auto|16|24|32) ;; *) mt_die 2 "--pcm-bits must be auto, 16, 24 or 32";; esac
case $SUBS in sidecar|keep|drop) ;; *) mt_die 2 "--subs must be sidecar, keep or drop";; esac
case $CONTAINER in auto|mov|mkv) ;; *) mt_die 2 "--container must be auto, mov or mkv";; esac
case $VIDEO_TARGET in auto|dnxhr_lb|dnxhr_sq|dnxhr_hq|dnxhr_hqx|dnxhr_444) ;; *) mt_die 2 "invalid --video-target";; esac
if [[ -n $CFR_RATE && ! $CFR_RATE =~ ^[0-9]+([./][0-9]+)?$ ]]; then mt_die 2 "--cfr needs a rate like 25 or 30000/1001"; fi

if ((PICK)); then
  mt_pick_files "Choose media to prepare for DaVinci Resolve" \
    "*.mkv *.mp4 *.mov *.webm *.avi *.m4v *.ts *.m2ts *.mts *.mpg *.mpeg *.flv *.wmv *.ogv | Video files" \
    || { mt_info "No files chosen."; exit 0; }
  FILES+=("${MT_PICKED[@]}")
fi
if ((${#FILES[@]} == 0)); then usage >&2; exit 2; fi
INTERACTIVE=0; [[ -t 0 ]] && INTERACTIVE=1
if [[ -z $MODE ]] && ((!INTERACTIVE)); then
  mt_die 2 "No mode given and no terminal to ask in. Use --audio-only, --video-only, --both or --analyze."
fi
if [[ -n $CFR_RATE && $MODE == audio ]]; then
  mt_die 2 "--cfr changes the video, which conflicts with --audio-only. Use --video-only or --both."
fi

mt_need "$FFMPEG" ffmpeg
mt_need "$FFPROBE" ffmpeg
mt_deps_or_die
# (captured first: "grep -q" closing the pipe early would trip pipefail)
ENC_LIST=$("$FFMPEG" -hide_banner -encoders 2>/dev/null)
if grep -qE '^ V[^ ]* +dnxhd ' <<<"$ENC_LIST"; then
  DNXHD_MISSING=0
else
  DNXHD_MISSING=1   # only fatal if a video conversion is actually needed
fi

# ------------------------------------------------------------ assessment ---
# These functions only ASSESS.  They set  *DEC (copy|convert = what the policy would
# suggest), *WHY (reason) and *UNC (1 = could not be judged from metadata).  The mode
# you choose decides what actually happens; see apply_mode().
AV_DEC=""; AV_WHY=""; AV_UNC=0
assess_video() {
  local i=$1 c=${S_CODEC[$i]} pix=${S_PIX[$i]} chroma depth
  AV_DEC=copy; AV_WHY=""; AV_UNC=0
  if mt_in_list "$c" "$VIDEO_COPY_CODECS"; then
    AV_WHY="$c is an intra-frame editing codec that Resolve decodes natively"; return
  fi
  case $c in
    h264|hevc)
      chroma=$(mt_pix_chroma "$pix"); depth=$(mt_pix_depth "$pix")
      if [[ -z $chroma || -z $depth ]]; then
        AV_UNC=1; AV_WHY="$c with unreadable pixel format '$pix' - cannot judge"; return
      fi
      if [[ $chroma == 420 && ( $depth == 8 || ( $c == hevc && $depth == 10 ) ) ]]; then
        AV_WHY="$c $chroma ${depth}-bit: supported by Resolve Studio (needs GPU decode support)"; return
      fi
      AV_DEC=convert
      local cl=$chroma; case $chroma in 420) cl=4:2:0;; 422) cl=4:2:2;; 444) cl=4:4:4;; esac
      AV_WHY="$c $cl ${depth}-bit ($pix): outside what AMD VCN hardware decodes (4:2:0 8-bit H.264, 4:2:0 8/10-bit HEVC); Resolve on Linux commonly fails or stutters on it"
      return ;;
    av1)
      AV_DEC=convert
      AV_WHY="AV1: the RX 6800 (RDNA2) has no AV1 hardware decode and Resolve-on-Linux AV1 decoding is unconfirmed"; return ;;
    vp9|vp8)
      AV_DEC=convert; AV_WHY="${c^^}: not on Resolve's supported-codec list (WebM-family codec)"; return ;;
    ffv1)
      AV_DEC=convert; AV_WHY="FFV1: not on Resolve's supported-codec list"; return ;;
  esac
  if mt_in_list "$c" "$VIDEO_UNKNOWN_CODECS"; then
    AV_UNC=1; AV_WHY="$c: Resolve support depends on profile/container and could not be confirmed from metadata"
    return
  fi
  AV_DEC=convert; AV_WHY="$c is not on the known-good video list"
}

AA_DEC=""; AA_WHY=""
assess_audio() {
  local i=$1 c=${S_CODEC[$i]}
  AA_DEC=copy; AA_WHY=""
  if mt_in_list "$c" "$AUDIO_COPY_CODECS"; then AA_WHY="uncompressed PCM"; return; fi
  AA_DEC=convert
  case $c in
    aac)       AA_WHY="AAC (${S_PROFILE[$i]:-LC}): Resolve on Linux has no AAC decoder - any profile, any container" ;;
    ac3|eac3)  AA_WHY="${c^^}: reported as undecodable by Resolve on Linux" ;;
    mp3)       AA_WHY="MP3: Linux support has been inconsistent between Resolve versions" ;;
    dts)       AA_WHY="DTS: not decodable by Resolve on Linux" ;;
    opus|vorbis) AA_WHY="${c^}: WebM-family codec, not on Resolve's list" ;;
    flac)      AA_WHY="FLAC: Linux support unconfirmed; FLAC->PCM is lossless, so converting costs no quality" ;;
    truehd|mlp) AA_WHY="TrueHD: not decodable by Resolve on Linux" ;;
    alac)      AA_WHY="ALAC: Linux support unconfirmed; converting to PCM is lossless" ;;
    *)         AA_WHY="$c is not on the known-good (PCM) audio list" ;;
  esac
}

# pcm_for INDEX -> prints the PCM codec to use for that audio stream
pcm_for() {
  local i=$1 bits=16 raw=${S_BITS[$1]:-} c=${S_CODEC[$1]}
  case $PCM_BITS in
    16|24|32) bits=$PCM_BITS ;;
    auto)
      if [[ $raw =~ ^[0-9]+$ ]] && ((raw > 16)); then bits=24
      elif [[ $c == flac || $c == alac || $c == truehd || $c == mlp ]]; then bits=24
      fi ;;
  esac
  echo "pcm_s${bits}le"
}

# video_target INDEX -> sets DN_PROFILE and DN_PIXFMT
video_target() {
  local i=$1 chroma depth t=$VIDEO_TARGET
  chroma=$(mt_pix_chroma "${S_PIX[$i]}"); depth=$(mt_pix_depth "${S_PIX[$i]}")
  if [[ $t == auto ]]; then
    if   [[ $chroma == 444 ]];            then t=dnxhr_444
    elif [[ -n $depth ]] && ((depth >= 10)); then t=dnxhr_hqx
    else t=dnxhr_hq; fi
  fi
  DN_PROFILE=$t
  case $t in
    dnxhr_hqx) DN_PIXFMT=yuv422p10le ;;
    dnxhr_444) DN_PIXFMT=yuv444p10le ;;
    *)         DN_PIXFMT=yuv422p ;;
  esac
}

sub_kind() {  # INDEX -> text | bitmap | other
  local c=${S_CODEC[$1]}
  if   mt_in_list "$c" "$SUB_TEXT_CODECS";   then echo text
  elif mt_in_list "$c" "$SUB_BITMAP_CODECS"; then echo bitmap
  else echo other; fi
}

# -------------------------------------------------------------- per file ---
N_OK=0; N_NONE=0; N_FAIL=0; QUIT=0; FILE_NO=0; FILE_TOTAL=${#FILES[@]}

describe_video() { local i=$1 fps; fps=$(mt_frac_to_num "${S_AFR[$i]:-0/0}")
  printf '%s %s%s %sx%s %s fps' "${S_CODEC[$i]}" "${S_PIX[$i]:-?}" "${S_PROFILE[$i]:+ (${S_PROFILE[$i]})}" "${S_W[$i]}" "${S_H[$i]}" "$fps"; }
describe_audio() { local i=$1
  printf '%s%s %sch %s Hz [%s]%s' "${S_CODEC[$i]}" "${S_PROFILE[$i]:+ ${S_PROFILE[$i]}}" "${S_CH[$i]:-?}" "${S_RATE[$i]:-?}" "$(mt_lang_norm "${S_LANG[$i]}")" "${S_TITLE[$i]:+ \"${S_TITLE[$i]}\"}"; }

mode_label() {
  case $1 in
    audio)   echo "Audio only  (audio -> PCM, video copied unchanged)" ;;
    video)   echo "Video only  (video -> DNxHR, audio copied unchanged)" ;;
    both)    echo "Both audio and video" ;;
    analyze) echo "Analyse only (nothing is written)" ;;
  esac
}

# choose_mode - interactive menu; sets CHOSEN to audio|video|both|analyze|exit
CHOSEN=""
choose_mode() {
  local ans
  while :; do
    printf '\n%sWhat should be converted for this file?%s\n' "$MT_C_BLD" "$MT_C_RST"
    printf '  1) Audio only\n  2) Video only\n  3) Both audio and video\n'
    printf '  4) Analyse the file and recommend a conversion (no encoding)\n  5) Exit\n'
    read -r -p 'Choose [1-5]: ' ans || { CHOSEN=exit; return; }
    case $ans in
      1) CHOSEN=audio ;;
      2) CHOSEN=video ;;
      3) CHOSEN=both ;;
      4) CHOSEN=analyze ;;
      5|q|Q|exit) CHOSEN=exit ;;
      *) printf 'Please type 1, 2, 3, 4 or 5.\n'; continue ;;
    esac
    return
  done
}

process_file() {
  local arg=$1 abs base stem ext outdir i tok k mode
  local -A VAD=() VAW=() VAU=() AAD=() AAW=() VD=() VW=() AD=() AW=()
  local v_conv=0 a_conv=0 remux=0 remux_why="" muxer outext final tmp rc sub_desc
  local -a A_ORDER=() CMD=() MAPS=() OPTS=() warnings=() kept_subs=() side_subs=() dropped=() conflicts=()

  [[ -e $arg ]] || { mt_err "Not found: $arg"; return 1; }
  [[ -f $arg ]] || { mt_err "Not a regular file: $arg"; return 1; }
  [[ -r $arg ]] || { mt_err "Not readable: $arg"; return 1; }
  abs=$(realpath -e -- "$arg") || { mt_err "Cannot resolve: $arg"; return 1; }
  base=$(basename -- "$abs"); stem=$(mt_stem "$base"); ext=$(mt_ext "$base")
  outdir=${OUT_DIR:-$(dirname -- "$abs")}
  [[ -d $outdir && -w $outdir ]] || { mt_err "Output directory missing or not writable: $outdir"; return 1; }

  mt_banner "File $FILE_NO of $FILE_TOTAL: $base"
  if ! mt_probe_format "$abs" || ! mt_probe_streams "$abs"; then
    mt_err "ffprobe could not read this file (corrupt, truncated, or not a media file)."; return 1
  fi
  if ((${#MT_VID[@]} == 0)); then
    mt_info "  No video stream (${#MT_AUD[@]} audio, ${#MT_SUB[@]} subtitle) - not a video file, skipped."
    mt_info "  For audio-only files: ffmpeg -i INPUT -c:a pcm_s24le OUTPUT.wav"
    return 3
  fi

  # ---- container facts -----------------------------------------------------
  for tok in ${FMT_NAME//,/ }; do
    case $tok in flv|ogg|asf|ivf) remux=1; remux_why="$tok container is not importable by Resolve" ;; esac
  done
  if mt_in_list "$ext" "$REMUX_EXTS"; then remux=1; remux_why="'.$ext' files are not recognised by Resolve (container problem, not a codec problem)"; fi
  mt_kv "Container:" "${FMT_NAME} (.${ext:-none})  -> ${remux_why:-container itself is fine}"
  [[ -n ${FMT_DUR} ]] && mt_kv "Duration:" "$(mt_hms "$FMT_DUR")"

  # ---- assessment (informational only) --------------------------------------
  printf '\n  %sAssessment%s (what the policy suggests - your chosen mode decides what is done)\n' "$MT_C_BLD" "$MT_C_RST"
  local label
  for i in "${MT_VID[@]}"; do
    assess_video "$i"; VAD[$i]=$AV_DEC; VAW[$i]=$AV_WHY; VAU[$i]=$AV_UNC
    if [[ $AV_UNC == 1 ]]; then label="uncertain"; elif [[ $AV_DEC == convert ]]; then label="likely needs conversion"; else label="looks compatible"; fi
    printf '  Video  #%-2s %s\n           -> %s: %s\n' "$i" "$(describe_video "$i")" "$label" "$AV_WHY"
    local r a; r=$(mt_frac_to_num "${S_RFR[$i]:-0/0}"); a=$(mt_frac_to_num "${S_AFR[$i]:-0/0}")
    if awk -v r="$r" -v a="$a" 'BEGIN{d=r-a; if(d<0)d=-d; exit !(r>0 && a>0 && d/r>0.02)}'; then
      mt_warn "video #$i: possible variable frame rate (nominal $r fps vs average $a fps). Frame rate is never changed unless you pass --cfr RATE."
    fi
    [[ ${S_FIELD[$i]:-progressive} =~ ^(tt|bb|tb|bt)$ ]] && mt_warn "video #$i is interlaced (${S_FIELD[$i]}); field order is passed through unchanged."
  done
  ((${#MT_VID[@]} > 1)) && mt_warn "${#MT_VID[@]} video streams found; all are carried over."
  ((${#MT_PIC[@]} > 0)) && dropped+=("${#MT_PIC[@]} attached picture(s) (cover art) - not carried over")
  ((${#MT_DATA[@]} > 0)) && dropped+=("${#MT_DATA[@]} data/timecode stream(s) - not mapped (timecode stays in stream metadata where FFmpeg exposes it)")
  ((${#MT_AUD[@]} == 0)) && printf '  Audio: none\n'
  for i in "${MT_AUD[@]}"; do
    assess_audio "$i"; AAD[$i]=$AA_DEC; AAW[$i]=$AA_WHY
    if [[ $AA_DEC == convert ]]; then label="likely needs conversion"; else label="looks compatible"; fi
    printf '  Audio  #%-2s %s\n           -> %s: %s\n' "$i" "$(describe_audio "$i")" "$label" "$AA_WHY"
  done

  # audio order (all tracks kept; only the order can change; no re-encoding involved)
  local REORDERED=0
  A_ORDER=("${MT_AUD[@]}")
  if [[ -n $PREFER_LANG && ${#MT_AUD[@]} -gt 1 ]]; then
    local -A used=(); local -a pref first=() rest=(); local p l
    IFS=',' read -r -a pref <<<"$PREFER_LANG"
    for p in "${pref[@]}"; do
      p=$(mt_lang_norm "$p")
      for i in "${MT_AUD[@]}"; do
        l=$(mt_lang_norm "${S_LANG[$i]}")
        if [[ $l == "$p" && -z ${used[$i]:-} ]]; then first+=("$i"); used[$i]=1; fi
      done
    done
    for i in "${MT_AUD[@]}"; do [[ -z ${used[$i]:-} ]] && rest+=("$i"); done
    if ((${#first[@]} > 0)); then
      A_ORDER=("${first[@]}" "${rest[@]}")
      [[ "${A_ORDER[*]}" != "${MT_AUD[*]}" ]] && REORDERED=1
    else
      mt_warn "--prefer-lang '$PREFER_LANG': no audio track is tagged with that language; source order kept. Track languages: $(for i in "${MT_AUD[@]}"; do printf '#%s=%s ' "$i" "$(mt_lang_norm "${S_LANG[$i]}")"; done)"
    fi
  fi

  # subtitles
  local lang
  for i in "${MT_SUB[@]}"; do
    k=$(sub_kind "$i"); lang=$(mt_lang_norm "${S_LANG[$i]}")
    case $SUBS in
      drop)    dropped+=("subtitle #$i (${S_CODEC[$i]}, $lang) - omitted (--subs drop)") ;;
      keep)    if [[ $k == other ]]; then dropped+=("subtitle #$i (${S_CODEC[$i]}, $lang) - unknown subtitle type, omitted")
               else kept_subs+=("$i"); fi ;;
      sidecar) if [[ $k == text ]]; then side_subs+=("$i")
               else dropped+=("subtitle #$i (${S_CODEC[$i]}, $lang) - $k subtitles cannot be converted to SRT without OCR; omitted"); fi ;;
    esac
    printf '  Sub    #%-2s %s [%s] (%s)\n' "$i" "${S_CODEC[$i]}" "$lang" "$k"
  done

  # ---- mode selection: YOUR choice, never inferred from the codecs ----------
  while :; do
    if   [[ -n $MODE_ALL ]]; then mode=$MODE_ALL
    elif [[ -n $MODE ]];     then mode=$MODE
    else choose_mode; mode=$CHOSEN; fi
    case $mode in
      exit)    mt_info "Exiting - nothing was written."; QUIT=1; return 4 ;;
      analyze)
        mt_banner "Analysis and recommendation"
        local ra=0 rv=0 rec
        for i in "${MT_AUD[@]}"; do [[ ${AAD[$i]} == convert ]] && ra=1; done
        for i in "${MT_VID[@]}"; do [[ ${VAD[$i]} == convert ]] && rv=1; done
        if   ((ra && rv)); then rec="both" ; elif ((ra)); then rec="audio-only"
        elif ((rv)); then rec="video-only"; else rec="none"; fi
        case $rec in
          audio-only) mt_ok "  Recommended: AUDIO ONLY - video can be copied untouched." ;;
          video-only) mt_ok "  Recommended: VIDEO ONLY - audio looks fine." ;;
          both)       mt_ok "  Recommended: BOTH audio and video." ;;
          none)       mt_ok "  Recommended: no conversion needed." ;;
        esac
        for i in "${MT_VID[@]}"; do
          [[ ${VAU[$i]} == 1 ]] && mt_info "  Note: video #$i is UNCERTAIN (${VAW[$i]}). Try it in Resolve first; convert only if import or playback fails."
        done
        ((remux)) && mt_info "  Note: $remux_why - even with 'no conversion', a stream-copy remux would be needed (--audio-only does that)."
        mt_info "  Metadata cannot prove an import will work; this is advice, not a decision."
        if [[ $rec != none ]]; then
          mt_info "  To act on it:  resolve-convert --${rec} $(printf '%q' "$arg")"
        fi
        if ((MODE_FROM_CLI)); then return 3; fi
        continue ;;
    esac
    break
  done

  # offer to reuse a menu choice for the remaining files
  local left=$((FILE_TOTAL - FILE_NO)) ans
  if [[ -z $MODE && -z $MODE_ALL ]] && ((left > 0)); then
    read -r -p "Apply '$mode' to all $left remaining file(s) without asking again? [y/N] " ans || ans=n
    [[ ${ans,,} == y || ${ans,,} == yes ]] && MODE_ALL=$mode
  fi

  # ---- apply the chosen mode -------------------------------------------------
  for i in "${MT_VID[@]}"; do
    case $mode in
      audio)      VD[$i]=copy;    VW[$i]="copied unchanged (audio-only mode)" ;;
      video|both) VD[$i]=convert; VW[$i]="converted because you chose it"; v_conv=1 ;;
    esac
  done
  for i in "${MT_AUD[@]}"; do
    case $mode in
      video)      AD[$i]=copy;        AW[$i]="copied unchanged (video-only mode)" ;;
      audio|both) AD[$i]=${AAD[$i]};  AW[$i]=${AAW[$i]}; [[ ${AD[$i]} == convert ]] && a_conv=1 ;;
    esac
  done

  # warnings where your choice differs from the assessment (choice wins)
  for i in "${MT_VID[@]}"; do
    if [[ $mode == audio ]]; then
      if [[ ${VAU[$i]} == 1 ]]; then warnings+=("video #$i is UNCERTAIN (${VAW[$i]}) - it is being COPIED UNCHANGED as you chose audio-only.")
      elif [[ ${VAD[$i]} == convert ]]; then warnings+=("video #$i is flagged as likely incompatible (${VAW[$i]}) - it is being COPIED UNCHANGED as you chose audio-only."); fi
    elif [[ ${VAD[$i]} == copy && ${VAU[$i]} != 1 ]]; then
      warnings+=("video #$i looks compatible already (${VAW[$i]}) - converting it anyway, as you chose. This costs time/disk space and one generation of quality.")
    fi
  done
  for i in "${MT_AUD[@]}"; do
    if [[ $mode == video && ${AAD[$i]} == convert ]]; then
      warnings+=("audio #$i is flagged (${AAW[$i]}) - it is being COPIED UNCHANGED as you chose video-only; Resolve may import it silent or not at all.")
    fi
  done
  if [[ $mode == audio || $mode == both ]]; then
    if ((${#MT_AUD[@]} == 0)); then
      if [[ $mode == audio ]]; then mt_err "You chose audio-only but this file has no audio stream. Nothing to do."; return 3; fi
      warnings+=("this file has no audio stream; only the video is converted.")
    elif ((!a_conv)); then
      warnings+=("no audio stream needs conversion (all are already PCM); audio is copied unchanged.")
      [[ $mode == audio ]] && warnings+=("audio-only therefore changes nothing but the container (a straight stream-copy remux).")
    fi
  fi
  if ((v_conv && DNXHD_MISSING)); then
    mt_err "Video conversion chosen but this FFmpeg build has no 'dnxhd' encoder."; return 1
  fi

  # ---- container choice ------------------------------------------------------
  outext=mov
  case $CONTAINER in
    mkv)  outext=mkv ;;
    auto) [[ $SUBS == keep && ${#kept_subs[@]} -gt 0 ]] && outext=mkv ;;
  esac
  if [[ $outext == mov ]]; then
    for i in "${MT_VID[@]}"; do
      [[ ${VD[$i]} == copy ]] && ! mt_in_list "${S_CODEC[$i]}" "$MOV_VIDEO_OK" && conflicts+=("video #$i (${S_CODEC[$i]}) is copied unchanged but cannot be stored in MOV")
    done
    for i in "${MT_AUD[@]}"; do
      [[ ${AD[$i]} == copy ]] && ! mt_in_list "${S_CODEC[$i]}" "$MOV_AUDIO_OK" && conflicts+=("audio #$i (${S_CODEC[$i]}) is copied unchanged but cannot be stored in MOV")
    done
  fi
  if ((${#conflicts[@]} > 0)); then
    mt_banner "Container conflict"
    for tok in "${conflicts[@]}"; do mt_info "  - $tok"; done
    if [[ $CONTAINER == mov ]]; then
      mt_err "You forced --container mov, so I cannot keep those streams unchanged. Use --container mkv, or choose a mode that converts them."; return 1
    fi
    if ((INTERACTIVE)); then
      printf '  1) Use MKV instead (streams stay unchanged)\n  2) Cancel this file\n'
      read -r -p 'Choose [1-2]: ' ans || ans=2
      if [[ $ans == 1 ]]; then outext=mkv; else mt_info "Cancelled - nothing written."; return 3; fi
    else
      mt_err "Stopped (no terminal to ask in). Re-run with --container mkv to keep those streams unchanged."; return 1
    fi
  fi
  case $outext in mkv) muxer=matroska ;; *) muxer=mov ;; esac
  if [[ $outext == mkv ]] && ((v_conv)); then
    warnings+=("MKV containing DNxHR is valid for FFmpeg, but Resolve's handling of it is unverified.")
  fi

  # ---- build the ffmpeg command (array - no eval, no word splitting) -----------
  local ov=0 oa=0 os=0 pcm
  local -a plan_lines=()
  for i in "${MT_VID[@]}"; do
    MAPS+=(-map "0:$i")
    if [[ ${VD[$i]} == convert ]]; then
      video_target "$i"
      OPTS+=("-c:v:$ov" dnxhd "-profile:v:$ov" "$DN_PROFILE" "-pix_fmt:v:$ov" "$DN_PIXFMT")
      mt_color_ok prim "${S_PRIM[$i]}"  && OPTS+=("-color_primaries:v:$ov" "${S_PRIM[$i]}")
      mt_color_ok trc "${S_TRC[$i]}"   && OPTS+=("-color_trc:v:$ov" "${S_TRC[$i]}")
      mt_color_ok space "${S_SPACE[$i]}" && OPTS+=("-colorspace:v:$ov" "${S_SPACE[$i]}")
      [[ ${S_RANGE[$i]} == pc ]] && warnings+=("video #$i is full-range; DNxHR is limited-range, so levels are scaled.")
      [[ ${S_TRC[$i]} == smpte2084 || ${S_TRC[$i]} == arib-std-b67 ]] && warnings+=("video #$i is HDR (${S_TRC[$i]}); colour tags are carried over, verify the Resolve colour-science settings.")
      plan_lines+=("Video #$i:|CONVERT -> DNxHR $DN_PROFILE ($DN_PIXFMT)   [$(describe_video "$i")]")
    else
      OPTS+=("-c:v:$ov" copy)
      [[ $outext == mov && ${S_CODEC[$i]} == hevc ]] && OPTS+=("-tag:v:$ov" hvc1)
      plan_lines+=("Video #$i:|COPY unchanged   [$(describe_video "$i")]")
    fi
    ((ov++))
  done
  if ((v_conv)); then
    if [[ -n $CFR_RATE ]]; then OPTS+=(-fps_mode cfr -r "$CFR_RATE"); plan_lines+=("Frame rate:|forced constant $CFR_RATE (--cfr)")
    else OPTS+=(-fps_mode passthrough); fi
    OPTS+=(-max_muxing_queue_size 4096)
  fi
  for i in "${A_ORDER[@]}"; do
    MAPS+=(-map "0:$i")
    if [[ ${AD[$i]} == convert ]]; then
      pcm=$(pcm_for "$i"); OPTS+=("-c:a:$oa" "$pcm")
      plan_lines+=("Audio #$i:|CONVERT -> $pcm   [$(describe_audio "$i")]")
    else
      OPTS+=("-c:a:$oa" copy)
      plan_lines+=("Audio #$i:|COPY unchanged   [$(describe_audio "$i")]")
    fi
    if ((REORDERED)); then
      if ((oa == 0)); then OPTS+=("-disposition:a:$oa" default); else OPTS+=("-disposition:a:$oa" 0); fi
    fi
    ((oa++))
  done
  ((REORDERED)) && plan_lines+=("Audio order:|preferred language(s) '$PREFER_LANG' first; all ${#MT_AUD[@]} tracks kept")
  if [[ $SUBS == keep ]]; then
    for i in "${kept_subs[@]}"; do
      k=$(sub_kind "$i")
      if [[ $outext == mkv ]]; then
        MAPS+=(-map "0:$i")
        if [[ ${S_CODEC[$i]} == mov_text ]]; then OPTS+=("-c:s:$os" srt); else OPTS+=("-c:s:$os" copy); fi
        ((os++))
      elif [[ $k == text ]]; then
        MAPS+=(-map "0:$i"); OPTS+=("-c:s:$os" mov_text); ((os++))
      else
        dropped+=("subtitle #$i (${S_CODEC[$i]}) - bitmap subtitles cannot go into MOV; omitted (use --container mkv)")
      fi
    done
    if [[ $outext == mkv ]]; then for i in "${MT_ATT[@]}"; do MAPS+=(-map "0:$i"); done; fi
  fi
  if ((${#MT_SUB[@]} == 0)); then sub_desc="none in this file"; else
  case $SUBS in
    sidecar) sub_desc="${#side_subs[@]} text subtitle(s) -> .srt file(s) next to the output" ;;
    keep)    sub_desc="${#kept_subs[@]} subtitle stream(s) kept inside the file" ;;
    drop)    sub_desc="omitted (--subs drop)" ;;
  esac
  fi

  final=$(mt_unique_path "$outdir" "$stem$OUT_SUFFIX" ".$outext" stamp)
  CMD=("$FFMPEG" -hide_banner -nostdin -loglevel warning -stats -y -i "file:$abs"
       "${MAPS[@]}" -map_metadata 0 -map_chapters 0 "${OPTS[@]}")

  # ---- plan summary -----------------------------------------------------------
  mt_banner "Plan"
  mt_kv "Input:" "$base"
  mt_kv "Mode:" "$(mode_label "$mode")"
  local pl
  for pl in "${plan_lines[@]}"; do mt_kv "${pl%%|*}" "${pl#*|}"; done
  mt_kv "Container:" ".$outext$([[ $outext == mov ]] && echo ' (QuickTime - PCM is native here; MP4 is avoided)')"
  mt_kv "Subtitles:" "$sub_desc"
  mt_kv "Output:" "$final"
  [[ ${final##*/} != "$stem$OUT_SUFFIX.$outext" ]] && mt_warn "An output with the plain name already exists; using a new name (nothing overwritten)."
  for tok in "${dropped[@]}";  do mt_kv "Not carried:" "$tok"; done
  for tok in "${warnings[@]}"; do mt_warn "$tok"; done

  if ((DRY)); then
    mt_info "  DRY RUN - would execute:"
    printf '    '; printf '%q ' "${CMD[@]}" -f "$muxer" "file:<temp file>"; printf '\n'
    return 3
  fi

  # ---- confirmation ------------------------------------------------------------
  if ((YES && MODE_FROM_CLI)); then
    :
  elif ((INTERACTIVE)); then
    read -r -p "Proceed with this plan? [Y/n/q=quit] " ans || ans=n
    case ${ans,,} in
      y|yes) ;;
      q|quit) mt_info "Quitting - nothing was written for this file."; QUIT=1; return 4 ;;
      *) mt_info "Cancelled - nothing written. Original untouched."; return 3 ;;
    esac
  else
    mt_err "Confirmation needed but there is no terminal. Re-run with --yes to confirm in advance."; return 1
  fi

  # ---- run ------------------------------------------------------------------------
  tmp=$(mt_mktemp_file "$outdir") || { mt_err "Cannot create a temporary file in $outdir (disk full / read-only?)"; return 1; }
  mt_info "  Working... (ffmpeg progress below; Ctrl+C aborts safely)"
  "${CMD[@]}" -f "$muxer" "file:$tmp"; rc=$?
  if ((rc != 0)); then
    rm -f -- "$tmp"
    mt_err "CONVERSION FAILED (ffmpeg exit code $rc). No output written; original untouched."
    return 1
  fi
  printf '\n'

  local od; od=$("$FFPROBE" -v error -show_entries format=duration -of default=nw=1:nk=1 -i "file:$tmp" 2>/dev/null)
  if [[ -z $od ]]; then
    rm -f -- "$tmp"; mt_err "ffmpeg reported success but the output cannot be read back; discarded."; return 1
  fi
  if [[ -n $FMT_DUR ]] && awk -v a="$FMT_DUR" -v b="$od" 'BEGIN{d=a-b; if(d<0)d=-d; exit !(d>2 && d/a>0.02)}'; then
    mt_warn "output duration ($(mt_hms "$od")) differs from the input ($(mt_hms "$FMT_DUR")) - check the result."
  fi

  mt_commit "$tmp" "$final" || { mt_err "Could not move result into place (name taken meanwhile?): $final"; return 1; }

  if [[ $SUBS == sidecar ]]; then
    local sidx sl sp stmp
    for sidx in "${side_subs[@]}"; do
      sl=$(mt_lang_norm "${S_LANG[$sidx]}")
      sp=$(mt_unique_path "$outdir" "$stem$OUT_SUFFIX.$sl" ".srt" counter)
      stmp=$(mt_mktemp_file "$outdir") || continue
      if "$FFMPEG" -hide_banner -nostdin -loglevel error -y -i "file:$abs" -map "0:$sidx" -c:s srt -f srt "file:$stmp" \
         && [[ -s $stmp ]] && mt_commit "$stmp" "$sp"; then
        mt_kv "Subtitle file:" "$sp"
        [[ ${S_CODEC[$sidx]} == ass || ${S_CODEC[$sidx]} == ssa ]] && mt_info "                 (ASS/SSA styling is flattened to plain SRT)"
      else
        rm -f -- "$stmp"; mt_warn "could not extract subtitle #$sidx to SRT."
      fi
    done
  fi

  mt_ok "CONVERSION COMPLETE: $final"
  mt_info "  (Streams were converted/copied exactly as in the plan. Open it in Resolve to confirm - metadata alone can't guarantee compatibility.)"
  return 0
}

for f in "${FILES[@]}"; do
  ((FILE_NO++))
  process_file "$f"; rc=$?
  case $rc in 0) ((N_OK++));; 3) ((N_NONE++));; 4) break;; *) ((N_FAIL++));; esac
  ((QUIT)) && break
done

mt_banner "Summary"
mt_info "  written: $N_OK   cancelled / analysed / skipped / dry-run: $N_NONE   failed: $N_FAIL"
((N_FAIL == 0))
