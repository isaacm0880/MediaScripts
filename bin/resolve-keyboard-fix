#!/bin/bash

for cmd in kdialog qdbus6; do command -v "$cmd" >/dev/null || { echo "Missing $cmd" >&2; exit 2; }; done

choice=$(kdialog --title "DaVinci Resolve Keyboard Fix" \
    --menu "This affects KDE's appmenu module for all applications. Choose an option:" \
    enable "Enable Resolve keyboard shortcut fix" \
    disable "Disable Resolve keyboard shortcut fix")

case "$choice" in
    enable)
        qdbus6 org.kde.kded6 /kded org.kde.kded6.unloadModule appmenu || { kdialog --error "Failed to unload appmenu"; exit 1; }
        kdialog --title "DaVinci Resolve" --msgbox "Keyboard shortcut fix enabled."
        ;;
    disable)
        qdbus6 org.kde.kded6 /kded org.kde.kded6.loadModule appmenu || { kdialog --error "Failed to load appmenu"; exit 1; }
        kdialog --title "DaVinci Resolve" --msgbox "Keyboard shortcut fix disabled."
        ;;
esac
