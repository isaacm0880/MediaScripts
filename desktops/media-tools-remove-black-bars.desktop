[Desktop Entry]
Type=Service
MimeType=image/jpeg;image/png;image/webp;image/tiff;image/bmp;image/avif;image/heic;
Actions=RemoveBlackBars
X-KDE-Priority=TopLevel

[Desktop Action RemoveBlackBars]
Name=Remove Black Borders
Icon=image-crop
Exec=sh -c 'for f do "/home/isaac/Custom/Scripts/media-tools/bin/remove-black-bars" "$f"; done' sh %F
