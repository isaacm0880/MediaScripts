[Desktop Entry]
Type=Service
Name=Extract Cover Art (PNG)
Icon=image-png
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=audio/*;
Actions=extractAudioArtwork;
X-KDE-Priority=TopLevel

[Desktop Action extractAudioArtwork]
Name=Extract Cover Art (PNG)
Icon=image-png
Exec=/home/isaac/Custom/Scripts/media-tools/bin/audio-extract-cover %F
