[Desktop Entry]
Type=Service
Name=Convert to PNG (img2png)
Comment=Convert images and layered XCF to PNG
Icon=image-png
MimeType=image/x-xcf;image/jpeg;image/webp;image/avif;image/tiff;image/bmp;image/gif;image/heif;image/heic;image/jp2;image/jxl;image/vnd.adobe.photoshop;image/x-tga;
Actions=Img2png
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel

[Desktop Action Img2png]
Name=Convert to PNG (img2png)
Icon=image-png
Exec=konsole -e /home/isaac/Custom/Scripts/media-tools/bin/img2png --pause %F
