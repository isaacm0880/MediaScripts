[Desktop Entry]
Type=Service
Name=Remove Black Bars (crop-bars)
Comment=Detect black bars, preview, confirm, then crop
Icon=transform-crop
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/x-flv;video/mp2t;
Actions=CropBars
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel

[Desktop Action CropBars]
Name=Remove Black Bars - analyse, preview, confirm (v2)
Icon=transform-crop
Exec=konsole -e /home/isaac/Custom/Scripts/media-tools/bin/crop-bars --preview --open --pause %F
