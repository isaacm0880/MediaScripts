#!/usr/bin/env bash
# Extract embedded cover artwork from selected audio files as PNGs.
set -u

if ! command -v ffmpeg >/dev/null 2>&1; then
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error 'FFmpeg is not installed. Install it with: sudo pacman -S ffmpeg'
    else
        printf '%s\n' 'FFmpeg is not installed. Install it with: sudo pacman -S ffmpeg' >&2
    fi
    exit 1
fi

success=0
skipped=0
failed=()

for input in "$@"; do
    [[ -f "$input" ]] || continue
    dir=$(dirname -- "$input")
    filename=$(basename -- "$input")
    stem="${filename%.*}"
    output="$dir/$stem.png"

    if [[ -e "$output" ]]; then
        if command -v kdialog >/dev/null 2>&1; then
            kdialog --yesno "The output already exists:\n$output\n\nOverwrite it?" || { skipped=$((skipped + 1)); continue; }
        else
            printf 'Skipping existing file: %s\n' "$output" >&2
            skipped=$((skipped + 1))
            continue
        fi
    fi

    # Map the first embedded picture stream and convert it to PNG.
    if ffmpeg -nostdin -hide_banner -loglevel error -y -i "$input" \
        -map 0:v:0 -frames:v 1 -c:v png "$output"; then
        success=$((success + 1))
    else
        rm -f -- "$output"
        failed+=("$filename")
    fi
done

message="Extracted artwork from $success file(s)."
(( skipped > 0 )) && message+=$'\nSkipped: '"$skipped"
if ((${#failed[@]})); then
    message+=$'\n\nCould not extract artwork (no embedded picture or unsupported file):\n'
    message+=$(printf '%s\n' "${failed[@]}")
fi

if command -v kdialog >/dev/null 2>&1; then
    if (( success == 0 )) && ((${#failed[@]})); then
        kdialog --error "$message"
    else
        kdialog --msgbox "$message"
    fi
else
    printf '%s\n' "$message"
fi
