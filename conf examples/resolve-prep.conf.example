# Copy to ~/.config/media-tools/resolve-prep.conf  (plain shell assignments).
# Precedence: command-line flag > environment variable > this file > defaults.
PREFER_LANG="eng"                 # audio languages to list first (all tracks kept)
SUBS=sidecar                      # sidecar | keep | drop
PCM_BITS=auto                     # auto | 16 | 24 | 32
VIDEO_TARGET=auto                 # auto | dnxhr_lb | dnxhr_sq | dnxhr_hq | dnxhr_hqx | dnxhr_444
# Codecs copied untouched. Add flac here ONLY if you have verified it imports on your Resolve.
AUDIO_COPY_CODECS="pcm_s16le pcm_s24le pcm_s32le"
VIDEO_COPY_CODECS="prores dnxhd"
VIDEO_UNKNOWN_CODECS="cfhd mjpeg mpeg4 mpeg2video"
MOV_AUDIO_OK="aac ac3 eac3 mp3 alac pcm_s16le pcm_s24le pcm_s32le"   # audio codecs MOV can hold
